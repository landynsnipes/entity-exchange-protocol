{
  "$ref": "#/definitions/entity-model",
  "definitions": {
    "entity-model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "controllerEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                ]
              },
              "sensitivity": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              },
              "sourceKind": {
                "type": "string",
                "enum": [
                  "principal_declared",
                  "agent_suggested",
                  "credential",
                  "attestation",
                  "imported_record"
                ]
              },
              "confirmationState": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "unconfirmed",
                  "rejected"
                ]
              },
              "evidenceReferences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "default": []
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "namespace",
              "name",
              "value",
              "sensitivity",
              "sourceKind",
              "confirmationState",
              "observedAt"
            ],
            "additionalProperties": false
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "entityId",
        "controllerEntityId",
        "modelVersion",
        "attributes",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
