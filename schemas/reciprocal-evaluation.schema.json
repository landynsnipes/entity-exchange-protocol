{
  "$ref": "#/definitions/reciprocal-evaluation",
  "definitions": {
    "reciprocal-evaluation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "decisionTraceId": {
          "type": "string",
          "format": "uuid"
        },
        "subjectEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "objectEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "subjectIntentId": {
          "type": "string",
          "format": "uuid"
        },
        "objectIntentId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "algorithmVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "eligible": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "subject",
                  "object"
                ]
              },
              "criterionId": {
                "type": "string",
                "format": "uuid"
              },
              "importance": {
                "type": "string",
                "enum": [
                  "required",
                  "preferred"
                ]
              },
              "disclosure": {
                "type": "string",
                "enum": [
                  "private",
                  "consented",
                  "public",
                  "sealed"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "satisfied",
                  "not_satisfied",
                  "unknown"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "evidenceReferences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "default": []
              },
              "containsSealedValue": {
                "type": "boolean",
                "const": false
              }
            },
            "required": [
              "side",
              "criterionId",
              "importance",
              "disclosure",
              "status",
              "rationale",
              "containsSealedValue"
            ],
            "additionalProperties": false
          }
        },
        "sealedCompatibilityCount": {
          "type": "integer",
          "minimum": 0
        },
        "sealedConflictCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingInformationCount": {
          "type": "integer",
          "minimum": 0
        },
        "subjectViewSnapshot": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "objectViewSnapshot": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "decisionTraceId",
        "subjectEntityId",
        "objectEntityId",
        "subjectIntentId",
        "objectIntentId",
        "purpose",
        "algorithmVersion",
        "score",
        "eligible",
        "confidence",
        "findings",
        "sealedCompatibilityCount",
        "sealedConflictCount",
        "missingInformationCount",
        "subjectViewSnapshot",
        "objectViewSnapshot",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
