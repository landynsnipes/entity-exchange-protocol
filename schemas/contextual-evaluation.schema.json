{
  "$ref": "#/definitions/contextual-evaluation",
  "definitions": {
    "contextual-evaluation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "subjectEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "objectEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "intentId": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "evaluatorPolicyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "validAt": {
              "type": "string",
              "format": "date-time"
            },
            "jurisdiction": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            }
          },
          "required": [
            "purpose",
            "evaluatorPolicyId",
            "validAt"
          ],
          "additionalProperties": false
        },
        "algorithmId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "algorithmVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "eligible": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterionId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "satisfied",
                  "partially_satisfied",
                  "not_satisfied",
                  "unknown"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidenceReferences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "default": []
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "criterionId",
              "status",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "hardConstraintFailures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "default": []
        },
        "missingInformation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "default": []
        },
        "evidenceSnapshotHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "subjectEntityId",
        "objectEntityId",
        "intentId",
        "scope",
        "algorithmId",
        "algorithmVersion",
        "eligible",
        "confidence",
        "findings",
        "evidenceSnapshotHash",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
