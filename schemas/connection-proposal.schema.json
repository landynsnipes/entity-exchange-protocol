{
  "$ref": "#/definitions/connection-proposal",
  "definitions": {
    "connection-proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "evaluationId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "initiatorEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "counterpartyEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "requestedDisclosureScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "default": []
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "proposed",
            "accepted",
            "declined",
            "withdrawn",
            "expired"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "evaluationId",
        "purpose",
        "initiatorEntityId",
        "counterpartyEntityId",
        "state",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
