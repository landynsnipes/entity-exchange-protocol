{
  "$ref": "#/definitions/standing-match-notification",
  "definitions": {
    "standing-match-notification": {
      "type": "object",
      "properties": {
        "standingVersion": {
          "type": "string",
          "const": "0.1.0-draft.1"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "authorizationId": {
          "type": "string",
          "format": "uuid"
        },
        "recipientEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "proposalId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "counterpartyKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scoreBand": {
          "type": "string",
          "enum": [
            "potential",
            "strong"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "read",
            "dismissed",
            "invalidated"
          ]
        },
        "containsIdentity": {
          "type": "boolean",
          "const": false
        },
        "containsSealedValues": {
          "type": "boolean",
          "const": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "invalidatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "standingVersion",
        "id",
        "authorizationId",
        "recipientEntityId",
        "proposalId",
        "purpose",
        "counterpartyKind",
        "scoreBand",
        "confidence",
        "summary",
        "state",
        "containsIdentity",
        "containsSealedValues",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
