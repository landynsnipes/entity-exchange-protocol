{
  "$ref": "#/definitions/entity-view-definition",
  "definitions": {
    "entity-view-definition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespacePrefix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "enum": [
                  "omit",
                  "consented",
                  "public",
                  "sealed"
                ]
              }
            },
            "required": [
              "namespacePrefix",
              "action"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "defaultAction": {
          "type": "string",
          "const": "omit"
        },
        "approvedByPrincipalAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "profileId",
        "purpose",
        "rules",
        "defaultAction",
        "approvedByPrincipalAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
