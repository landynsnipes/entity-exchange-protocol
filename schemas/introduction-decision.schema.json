{
  "$ref": "#/definitions/introduction-decision",
  "definitions": {
    "introduction-decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "matchId": {
          "type": "string",
          "format": "uuid"
        },
        "actorEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "actorRole": {
          "type": "string",
          "enum": [
            "candidate",
            "employer"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "withdrawn",
            "expired"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "matchId",
        "actorEntityId",
        "actorRole",
        "state",
        "decidedAt",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
