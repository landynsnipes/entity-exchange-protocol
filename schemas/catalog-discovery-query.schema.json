{
  "$ref": "#/definitions/catalog-discovery-query",
  "definitions": {
    "catalog-discovery-query": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "requesterEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "authorizationId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "acceptedProfileIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "desiredEntityKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1
        },
        "discoveryTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 50,
          "default": []
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "federation": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean",
              "default": false
            },
            "remainingHops": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 0
            },
            "visitedCatalogIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 50,
              "default": []
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "requesterEntityId",
        "authorizationId",
        "purpose",
        "acceptedProfileIds",
        "desiredEntityKinds",
        "federation",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
