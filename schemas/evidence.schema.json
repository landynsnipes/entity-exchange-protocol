{
  "$ref": "#/definitions/evidence",
  "definitions": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "subjectEntityId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "project",
            "github_repository",
            "attestation",
            "credential",
            "work_sample"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "consented",
            "public"
          ],
          "default": "private"
        },
        "verification": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "self_asserted",
                "linked",
                "attested",
                "credential_verified",
                "demonstrated"
              ]
            },
            "verifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "verifiedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "level"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "sourceType": {
              "type": "string",
              "enum": [
                "manual",
                "github",
                "credential",
                "attestation",
                "system"
              ]
            },
            "sourceUri": {
              "type": "string",
              "format": "uri"
            },
            "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "importedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "sourceType",
            "observedAt"
          ],
          "additionalProperties": false
        },
        "demonstratedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "subjectEntityId",
        "title",
        "evidenceType",
        "verification",
        "provenance",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
